{
    "manifest_version":  3,
    "name":  "Recruiter Finder",
    "description":  "Find recruiter and HR email addresses at any company using multiple data sources. Export to Google Sheets.",
    "version":  "1.0.0",
    "permissions":  [
                        "identity",
                        "storage",
                        "sidePanel"
                    ],
    "oauth2":  {
                   "client_id":  "YOUR_CLIENT_ID.apps.googleusercontent.com",
                   "scopes":  [
                                  "https://www.googleapis.com/auth/spreadsheets"
                              ]
               },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "side_panel":  {
                       "default_path":  "sidepanel.html"
                   },
    "action":  {
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    },
                   "default_title":  "Recruiter Finder"
               },
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "host_permissions":  [
                             "https://api.hunter.io/*",
                             "https://api.snov.io/*",
                             "https://api.tomba.io/*",
                             "https://api.getprospect.com/*",
                             "https://api.prospeo.io/*",
                             "https://api.dropcontact.com/*",
                             "https://api.anymailfinder.com/*",
                             "https://google.serper.dev/*",
                             "https://serpapi.com/*",
                             "https://api.quickemailverification.com/*",
                             "https://sheets.googleapis.com/*",
                             "https://dns.google/*",
                             "https://cloudflare-dns.com/*"
                         ]
}
